<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <webSocket enabled="true" />
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\DeskFerry.Relay.dll" stdoutLogEnabled="false" stdoutLogFile="%HOME%\LogFiles\Application\deskferry-stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
