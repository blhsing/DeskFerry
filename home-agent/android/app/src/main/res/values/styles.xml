<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/df_bg</item>
        <item name="android:colorPrimary">@color/df_primary</item>
        <item name="android:colorPrimaryDark">@color/df_bg</item>
        <item name="android:colorAccent">@color/df_primary</item>
        <item name="android:colorControlActivated">@color/df_primary</item>
        <item name="android:statusBarColor">@color/df_bg</item>
        <item name="android:navigationBarColor">@color/df_bg</item>
        <item name="android:windowLightStatusBar">@bool/df_light_system_bars</item>
    </style>

    <style name="ViewerTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">#FF0B1220</item>
        <item name="android:colorPrimary">#FF4F8BFF</item>
